FROM node:20-alpine

WORKDIR /app

# Install system dependencies: python3, ffmpeg, ca-certificates, and curl
RUN apk add --no-cache \
    python3 \
    ffmpeg \
    ca-certificates \
    curl

# Install the standalone yt-dlp binary
RUN curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp \
    && chmod a+rx /usr/local/bin/yt-dlp

# Copy package files and install all dependencies (including devDependencies for Nest CLI)
COPY package*.json ./
RUN npm install

# Expose port
EXPOSE 3001

# Start NestJS in watch mode for hot-reload
CMD ["npm", "run", "start:dev"]